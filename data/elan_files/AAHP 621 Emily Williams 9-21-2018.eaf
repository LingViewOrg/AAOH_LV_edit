			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a127" TIME_SLOT_REF1="ts252" TIME_SLOT_REF2="ts253">
				<ANNOTATION_VALUE>Yes. You did whatever it took to get the job done.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
				<ANNOTATION_VALUE>Cleaning house, cooking, making your bed. Oh, raking yards. Cutting wood. You did all of that.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a131" TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts261">
				<ANNOTATION_VALUE>Yes. What's the ax for the, the heater. You had to have wood to go in the heater. You had to pump your water with the pump. Pump water. Yes. You had to do all of that.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
