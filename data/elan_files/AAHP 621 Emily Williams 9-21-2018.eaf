		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a123" TIME_SLOT_REF1="ts244" TIME_SLOT_REF2="ts245">
				<ANNOTATION_VALUE>Oh, sure. I really knew. I already knew how, 'cause my mom and dad had already taught us how to work and we already knew what to do. Mm-hmm &lt;affirmative&gt;. It didn't come hard. You already knew what to do.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
