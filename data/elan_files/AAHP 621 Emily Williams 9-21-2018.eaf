			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a221" TIME_SLOT_REF1="ts440" TIME_SLOT_REF2="ts441">
				<ANNOTATION_VALUE>Hmm. Wow. It wasn't very much, but it kept maybe around about, I guess about three or $4 an hour or something like that.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
