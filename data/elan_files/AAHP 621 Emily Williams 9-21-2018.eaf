			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a117" TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts233">
				<ANNOTATION_VALUE>It played a great deal because back then teachers believed in you learning. You had to learn. You didn't go to school every day just to sit around and play. You went to school to learn. They actually taught you,</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
