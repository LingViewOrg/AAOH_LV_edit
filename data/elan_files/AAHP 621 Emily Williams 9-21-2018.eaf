			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts237">
				<ANNOTATION_VALUE>Right? You had like homemaking and you had like, um, they had like the, the gathering of the, um, the, the vegetables. You had to like clean those and get 'em prepared to go into the freezer. Yeah. We did all</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a121" TIME_SLOT_REF1="ts240" TIME_SLOT_REF2="ts241">
				<ANNOTATION_VALUE>Right. Mm-hmm &lt;affirmative&gt;.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
