		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
				<ANNOTATION_VALUE>It, um, made me feel kind of bad about it.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
				<ANNOTATION_VALUE>Yeah. You know, when you talk about things, it makes you feel better. When you can bring it out and talk about it, it makes you feel better.</ANNOTATION_VALUE>
