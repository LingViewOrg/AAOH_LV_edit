			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a219" TIME_SLOT_REF1="ts436" TIME_SLOT_REF2="ts437">
				<ANNOTATION_VALUE>It was a great experience. I enjoyed, uh, classes and being, uh, with the other kids and talking and discussing our classes. And I had a job working in the library mm-hmm &lt;affirmative&gt;. And I enjoyed it. And doing that after classes, I would go into the library and work in the library, do typing and filing books in the library. Okay. And I, that was my job and I got paid to do that.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
