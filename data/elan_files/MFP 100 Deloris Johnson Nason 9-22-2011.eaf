                TIME_SLOT_REF1="ts1044" TIME_SLOT_REF2="ts1045">
                <ANNOTATION_VALUE>If you were the person that was the mayor of Greenwood and in charge of making sure the communities showed the love and got together what kind of plans and programs would you have</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545"
                TIME_SLOT_REF1="ts1046" TIME_SLOT_REF2="ts1085">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546"
                TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1087">
                <ANNOTATION_VALUE>Missus Nason I want to thank you for taking the time to speak with me on behalf of the Sam Proctor Oral History Program</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547"
                TIME_SLOT_REF1="ts1088" TIME_SLOT_REF2="ts1091">
                <ANNOTATION_VALUE>We appreciate your interview</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548"
                TIME_SLOT_REF1="ts1092" TIME_SLOT_REF2="ts1095">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549"
                TIME_SLOT_REF1="ts1096" TIME_SLOT_REF2="ts1097">
                <ANNOTATION_VALUE>Thank you</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550"
                TIME_SLOT_REF1="ts1098" TIME_SLOT_REF2="ts1099">
                <ANNOTATION_VALUE>I appreciate it</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551"
                TIME_SLOT_REF1="ts1100" TIME_SLOT_REF2="ts1101">
                <ANNOTATION_VALUE>I like to close every interview by giving the person I’m speaking with a chance to say the last thing</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552"
                TIME_SLOT_REF1="ts1102" TIME_SLOT_REF2="ts1103">
                <ANNOTATION_VALUE>So I’m going to turn to you and when you finish your comments then I will end the interview</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553"
                TIME_SLOT_REF1="ts1104" TIME_SLOT_REF2="ts1105">
                <ANNOTATION_VALUE>I’m not going to say nothing else</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554"
                TIME_SLOT_REF1="ts1106" TIME_SLOT_REF2="ts1128">
                <ANNOTATION_VALUE/>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
