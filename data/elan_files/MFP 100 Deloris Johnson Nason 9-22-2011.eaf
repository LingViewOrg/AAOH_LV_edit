                TIME_SLOT_REF1="ts610" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>I only have one computer but I bet you it be nine or ten children on that one computer</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187"
