                TIME_SLOT_REF1="ts532" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>We get together and we go and pick up paper out of our park because we love our park</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
