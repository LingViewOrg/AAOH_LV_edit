                <ANNOTATION_VALUE>Yeah a lot of- A lot of paperwork.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401"
                TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts751">
                <ANNOTATION_VALUE>Do you mean as part of the Association of Black Alumni, or just in general as active alumni?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402"
                TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Yeah. Some people are just affected it differently.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403"
                TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts773">
                <ANNOTATION_VALUE>Or not affected.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404"
                TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Oh, really?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405"
                TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>Yeah. It can be a hit and miss.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406"
                TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>I’m on Facebook, too.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407"
                TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>It can be—</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408"
                TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>I get in touch with people I haven’t seen since high school.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409"
                TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Well, thank you very much.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410"
                TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>I’m going to go ahead and stop this.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
